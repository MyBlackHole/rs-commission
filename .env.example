# Replace with output from: openssl rand -hex 24
# Use hex characters to avoid URL-escaping mistakes in DATABASE_URL.
POSTGRES_PASSWORD=replace_with_a_random_hex_secret

# External platform pull worker is opt-in. Keep false until platform connections and secrets are configured.
PLATFORM_SYNC_WORKER=false
PLATFORM_SYNC_INTERVAL_SECONDS=60

# Platform connections store only env:NAME references. Define real secrets outside source control, for example:
# TAOBAO_MAIN={"app_key":"...","app_secret":"...","session":"..."}
# DOUYIN_MAIN={"app_key":"...","app_secret":"...","access_token":"..."}
# MEITUAN_MAIN={"app_key":"...","app_secret":"..."}
