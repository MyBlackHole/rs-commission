{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "分润台",
  "version": "0.3.0",
  "identifier": "com.rscommission.console",
  "build": {
    "beforeDevCommand": "trunk serve --features tauri --dist dist-tauri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --release --locked --features tauri --dist dist-tauri",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label":"main","title":"分润台","width":1280,"height":850,"minWidth":360,"minHeight":600}],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {"active":false,"icon":["icons/icon.png","icons/icon.ico"]}
}
